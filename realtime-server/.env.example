# ANIMUS 1.0 — TEMPLAR SOC — realtime relay configuration

PORT=8787

# Comma-separated list of browser origins allowed to talk to this relay.
# Both the CORS headers and the explicit origin-allowlist middleware use this.
ALLOWED_ORIGINS=https://soc.templarhq.xyz,https://animus.templarhq.xyz,http://localhost:5173

# Signs the short-lived access JWT. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Access token lifetime (minutes) and refresh-token inactivity window (minutes).
ACCESS_TOKEN_TTL_MIN=20
REFRESH_INACTIVITY_TTL_MIN=60

# One-time bootstrap for the single organizer credential — only used if no
# credential is set yet. Afterward, rotate with:
#   npm run set-admin-credentials -- --username=<user> --password=<pass>
ADMIN_BOOTSTRAP_USER=organizer
ADMIN_BOOTSTRAP_PASS=change-me-before-the-event

# Where SQLite + uploaded sound files live (persisted across restarts).
DATA_DIR=./data

# ---- Splunk search proxy (POST /api/search, GET /api/search/anchor) ----
# Management API (port 8089), reached from this host — never exposed to
# players directly. Use a dedicated read-only, index-scoped service
# account (e.g. role "templar_relay"), never the Splunk admin account.
SPLUNK_HOST=127.0.0.1
SPLUNK_MGMT_PORT=8089
SPLUNK_USERNAME=templar_relay
SPLUNK_PASSWORD=change-me
# Splunk's default cert on a fresh install is self-signed; leave false
# unless a real CA-signed cert is installed on the management port.
SPLUNK_VERIFY_TLS=false
# Single index all log sources (Windows Security, Sysmon, IIS, DNS,
# future Apache/WAF, ...) are forwarded into, differentiated by
# sourcetype. Only used for the time-range anchor query and guardrails —
# never referenced when executing a player's own SPL.
SPLUNK_INDEX=templar_investigation
SPLUNK_SEARCH_TIMEOUT_MS=45000
SPLUNK_MAX_RESULTS=5000
